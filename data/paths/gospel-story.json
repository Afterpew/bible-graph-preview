{
  "id": "gospel-story",
  "title": "The Gospel Story",
  "description": "The whole Bible read as one continuous journey that traces Christ from the first promise in Genesis to the new creation in Revelation. Every chapter of the 66-book canon, in nine movements, each passage placed where it deepens the unfolding story of Christ.",
  "audience": "Anyone ready to read the entire Bible once, in an order built to reveal Christ on every page.",
  "coverage": "full",
  "order": "enforced",
  "canon_layers": [
    "core"
  ],
  "movements": [
    {
      "numeral": "I",
      "title": "The Promise Planted",
      "blurb": "A good world, a fall, and one promise: an offspring will crush the serpent. The journey's thesis is unveiled immediately, then the hunt for the promised family begins.",
      "start_node": "gen-1-3",
      "node_count": 14
    },
    {
      "numeral": "II",
      "title": "Redemption's Pattern",
      "blurb": "Exodus to Deuteronomy: lamb, sea, law, tent, priest, sacrifice. Israel's rescue writes the vocabulary the cross will speak, and the law's own last word is that someone greater is coming.",
      "start_node": "exod-1-4",
      "node_count": 29
    },
    {
      "numeral": "III",
      "title": "The Longed-For King",
      "blurb": "Conquest, judges, and the ache for a king; David anointed and the covenant that carries every messianic hope; the king's own psalms; Solomon's wisdom and the temple, and both of them failing forward toward someone greater.",
      "start_node": "josh-1-5",
      "node_count": 51
    },
    {
      "numeral": "IV",
      "title": "The Kingdom Torn, the Prophets Rise",
      "blurb": "The kingdom splits and slides toward ruin while the prophets open God's lawsuit — and inside the indictments, the promises sharpen: a child called Mighty God, a ruler from Bethlehem, mercy for enemies.",
      "start_node": "1kgs-12-16",
      "node_count": 23
    },
    {
      "numeral": "V",
      "title": "Exile: The Servant and the Son of Man",
      "blurb": "Jerusalem burns and the promise looks dead. In the ashes God promises a new covenant, a shepherd king, a kingdom for one like a son of man — and a Servant whose suffering carries it all. The Old Testament's summit is climbed from the valley.",
      "start_node": "2kgs-18-20",
      "node_count": 58
    },
    {
      "numeral": "VI",
      "title": "Return, Retelling, and the Last Word",
      "blurb": "Home from exile, the people rebuild small and wait long. Chronicles retells the whole story so the line stays findable, the last prophets sketch a pierced king and a sudden Lord, and the Old Testament goes silent mid-sentence.",
      "start_node": "1chr-1-9",
      "node_count": 32
    },
    {
      "numeral": "VII",
      "title": "The Word Made Flesh",
      "blurb": "The silence breaks with a genealogy. All four witnesses tell one story: the promises converge on Jesus, the pilgrim psalms climb with him to Jerusalem, the Passover Hallel is sung at his table, and the Lamb dies at Passover.",
      "start_node": "matt-1-2",
      "node_count": 29
    },
    {
      "numeral": "VIII",
      "title": "The Spirit and the Church",
      "blurb": "The Son ascends on Daniel's clouds and Joel's Spirit falls. The story you just read gets preached across the empire, the letters unfold what the cross accomplished, and Hebrews recapitulates the whole Old Testament with Jesus as its point.",
      "start_node": "acts-1",
      "node_count": 45
    },
    {
      "numeral": "IX",
      "title": "The Lamb on the Throne",
      "blurb": "Revelation gathers every thread: Daniel's Son of Man, Ezekiel's throne and temple, Egypt's plagues, Babel's fall, Eden's tree. The journey ends where the Psalter ends: everything that has breath, praising.",
      "start_node": "rev-1-3",
      "node_count": 9
    }
  ],
  "sequence": [
    {
      "node": "gen-1-3",
      "note": "The story opens with a good world, image-bearers, ruin, and a promise: an offspring will crush the serpent. Every step after this walks toward him."
    },
    {
      "node": "john-1",
      "note": "Reflection, not sequence: John's prologue is inspired commentary on the chapter you just read, revealing the Word who was already at work in Genesis 1. See creation on its own terms first; then let John name its Maker."
    },
    {
      "node": "gen-4-5",
      "note": "Sin spreads until the nations scatter; the world now needs the promised offspring, and the story starts hunting for the family he will come through."
    },
    {
      "node": "gen-6-9"
    },
    {
      "node": "gen-10-11"
    },
    {
      "node": "gen-12-17",
      "note": "God names the family: in Abram's seed all nations will be blessed. Paul will tell the Galatians that seed is Christ."
    },
    {
      "node": "gen-18-23",
      "note": "A beloved son carries wood up a mountain to be offered, and God provides the substitute. Moriah sketches Calvary two thousand years early."
    },
    {
      "node": "gen-24-26",
      "note": "The promise survives another generation; the line to the offspring holds by ordinary providence."
    },
    {
      "node": "gen-27-28",
      "note": "The chosen family gets its name, Israel, and its twelve tribes: the nation the Messiah will be born into."
    },
    {
      "node": "gen-29-31"
    },
    {
      "node": "gen-32-36"
    },
    {
      "node": "gen-37-41",
      "note": "The rejected brother who saves his betrayers previews the pattern: what men mean for evil, God means for saving good."
    },
